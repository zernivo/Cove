{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cove",
  "version": "0.3.0",
  "identifier": "app.cove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cove",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "maximized": true,
        "center": true
      },
      {
        "label": "search",
        "title": "Cove Search",
        "url": "search.html",
        "width": 680,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "center": true,
        "shadow": true,
        "focus": false
      },
      {
        "label": "dock",
        "title": "Cove Dock",
        "url": "dock.html",
        "width": 600,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}